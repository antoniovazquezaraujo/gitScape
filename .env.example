# Token de GitHub. Opcional para repositorios públicos; recomendado para no agotar
# el límite anónimo (60 peticiones/hora). Usa un token de solo lectura y NUNCA lo
# subas al repositorio: .env está ignorado por git.
VITE_GITHUB_TOKEN=

# Repositorio a visualizar
VITE_GITHUB_OWNER=tu-usuario
VITE_GITHUB_REPO=tu-repositorio
VITE_GITHUB_BRANCH=main
